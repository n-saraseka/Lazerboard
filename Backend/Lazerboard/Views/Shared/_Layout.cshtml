<!DOCTYPE html>
<html lang="en">
<head>
    <title>@ViewData["Title"] / Lazerboard</title>
    <link rel="stylesheet" href="~/styles/styles.css" asp-append-version="true">
    @await RenderSectionAsync("Styles", required: false)
    <link rel="icon" type="image/png" href="~/favicon/favicon-96x96.png" sizes="96x96" asp-append-version="true"/>
    <link rel="icon" type="image/svg+xml" href="~/favicon/favicon.svg" asp-append-version="true"/>
    <link rel="shortcut icon" href="~/favicon/favicon.ico" asp-append-version="true"/>
    <link rel="apple-touch-icon" sizes="180x180" href="~/favicon/apple-touch-icon.png" asp-append-version="true"/>
    <meta name="apple-mobile-web-app-title" content="Lazerboard"/>
    <link rel="manifest" href="~/favicon/site.webmanifest" asp-append-version="true"/>
    <meta name="description" content="Lazerboard: a database of all osu!lazer leaderboards with various statistics"/>
    <meta name="keywords" content="osu, leaderboard, lazer, osu!, osu!lazer, statistics, osu statistics, osu! stats, osu! statistics, rankings, osu! rankings, osu rankings, osu leaderboards, osu leaderboard farming"/>
</head>
<body>
@RenderBody()
<script type="module" src="~/react/assets/index.js" asp-append-version="true"></script>
</body>
</html>