@{
    ViewBag.Title = "Page not found";
    ViewData["ActivePage"] = "error";
}

<div class="error">
    <h1>Content not found</h1>
    <p>Whatever you were looking for doesn't exist. It might've never existed or has been removed.</p>
    <p>Perhaps you made a typo. Check if the provided URL is correct and try again.</p>
</div>