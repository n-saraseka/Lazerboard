lazer.board {
    tls internal
    encode gzip
    
    handle /api/fetcher/* {
        reverse_proxy scorefetcher:8080
    }
    
    handle /api/* {
        reverse_proxy backend:8080
    }
    
    handle /favicon/* {
        root * /srv/www
        file_server
    }
    
    handle /scripts/* {
        root * /srv/www
        file_server
    }

    handle /styles/* {
        root * /srv/www
        file_server
    }
    
    handle /react/* {
        root * /srv/www
        file_server
    }
    
    handle /images/* {
        root * /srv/www
        file_server
    }
    
    handle /grafana/* {
        reverse_proxy grafana:3000
    }
    
    handle {
        reverse_proxy backend:8080
    }

    header {
        Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
        X-Content-Type-Options "nosniff"
        Referrer-Policy "strict-origin-when-cross-origin"
    }
}