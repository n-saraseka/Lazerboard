# Postgres configuration
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=lazerleaderboards
POSTGRES_HOST=localhost
PGDATA=/data/postgres

# Redis configuration
REDIS_PASSWORD=redisiloveredis
REDIS_USER=redisiloveredis
REDIS_USER_PASSWORD=redisiloveredis

# RabbitMQ configuration
RABBITMQ_USER=ooorabbitmqissocool
RABBITMQ_PASSWORD=ooorabbitmqissocool
RABBITMQ_SERVER_ADDITIONAL_ERL_ARGS=-rabbit disk_free_limit 2147483648

# General backend services configuration
ASPNETCORE_ENVIRONMENT=Development
Database__Database=lazerleaderboards
Database__Host=db
Database__Port=5432
Database__Username=postgres
Database__Password=postgres
Redis__Host=redis
Redis__Username=redisiloveredis
Redis__Password=redisiloveredis
RabbitMQ__Username=ooorabbitmqissocool
RabbitMQ__Password=ooorabbitmqissocool

# Migrations configuration
AdminUserId = 0

# Backend service configuration
Reports__ReportsWindow=60 # In minutes
Reports__SpamReportCooldown=20 # In minutes
Reports__FalseReportCooldown=60 # In minutes
Reports__SpamReportsMax=15 # Enforce cooldown after this amount of reports
Reports__FalseReportsMax=10 # Enforce cooldown after this amount of reports

# External APIs configuration
ExternalApis__Host=externalapis
ExternalApis__Port=8080
ExternalApis__OsuApi__ClientId=00000
ExternalApis__OsuApi__ClientSecret=abunchfofbase64
ExternalApis__OsuApi__CallbackUrl=/oauth/callback
ExternalApis__OsuApi__MaxRpm=60
ExternalApis__OsuDotDirect__MaxRpm=120

# Score fetcher configuration
FetcherServices__MainSeeding=true
FetcherServices__SecondarySeeding=false
FetcherServices__Firehose=true
FetcherServices__Rescans=false
FetcherServices__Backpopulator=false
FetcherServices__UserScans=false
FetcherServices__UnlistedUserScans=false
FetcherServices__UserUpdates=false
SeedingBehavior__OnlyUpdateMapsetData=false # If you only want to update the beatmapset data and skip leaderboards.
Caching__FileTTL=15 # Expressed in minutes
ScoreCountUpdateIntervalMinutes=15
UserUpdatesIntervalHours=2 # Determines the update rate for unrestricted user updates
UserUpdatesLookbackHours=12 # Determines the lookback interval for unrestricted user updates
RestrictedUsersUpdateIntervalHours=12 # Determines the update rate for restricted user updates
ReportedUsersUpdateIntervalMinutes=15 # Determines the update rate for reported user updates
Rescans__Modes=0,1,2,3 # Determines mode leaderboards that should be reprocessed during the rescan

# Discord hooks service configuration

# Most recent processed beatmapset
DiscordHooks__BeatmapScores__HookURL=https://discord.com
DiscordHooks__BeatmapScores__Enabled=true
DiscordHooks__BeatmapScores__UpdateIntervalMinutes=60
# Most recent scanned beatmapset
DiscordHooks__Scans__HookURL=https://discord.com
DiscordHooks__Scans__Enabled=true
DiscordHooks__Scans__UpdateIntervalMinutes=60