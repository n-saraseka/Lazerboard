@model Lazerboard.ViewModels.UserViewModel

@{
    ViewBag.Title = $"{Model.User.Username}'s profile";
    ViewData["ActivePage"] = "user";
}

@section Styles {
    <link rel="stylesheet" href="~/styles/styles-user.css" asp-append-version="true">
}

<div class="react-app" data-page="user" data-count='@ViewData["ScoresCount"]' data-props='@Json.Serialize(Model)'></div>