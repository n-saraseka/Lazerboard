{
    metrics {
        per_host
    }
}

:2020 {
    # A solution from this article: 
    # https://blog.valentinvie.fr/collect-caddy-logs-securely-using-prometheus-restrict-admin-api-access/
    handle /metrics { 
        reverse_proxy localhost:2019 {
            header_up Host localhost:2019
        }
    }
    handle {
        abort
    }
}

lazer.board {
    tls internal
    encode gzip
    
    handle /api/fetcher/* {
        reverse_proxy scorefetcher:8080
    }
    
    handle /api/* {
        reverse_proxy backend:8080
    }

    handle /styles/* {
        root * /srv/www
        file_server
    }
    
    handle /react/* {
        root * /srv/www
        file_server
    }
    
    handle /images/* {
        root * /srv/www
        file_server
    }
    
    handle {
        reverse_proxy backend:8080
    }

    header {
        Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
        X-Content-Type-Options "nosniff"
        Referrer-Policy "strict-origin-when-cross-origin"
    }
}

status.lazer.board {
    tls internal
    encode gzip
    
    handle /grafana/* {
        reverse_proxy grafana:3000
    }
    
    header {
        Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
        X-Content-Type-Options "nosniff"
        Referrer-Policy "strict-origin-when-cross-origin"
    }
}